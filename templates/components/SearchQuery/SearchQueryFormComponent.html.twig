<div{{ attributes }}>
    {% import 'form_macros.html.twig' as macros %}
    <div data-controller="form">
        {{ form_start(form, {
            attr: {
                novalidate: true,
                'data-action': 'live#action:prevent',
                'data-live-action-param': 'files|save',
            }
        }) }}
        <div class="flex flex-col gap-3">
            {{ macros.tailwind_form_row(form.leadType) }}
            {{ macros.tailwind_form_row(form.query) }}


{#            <div class="grid grid-cols-2 gap-3 ">#}
{#                {{ macros.tailwind_form_row(form.leadType) }}#}
{#                {{ macros.tailwind_form_row(form.industry) }}#}
{#            </div>#}
{#            {{ macros.tailwind_form_row(form.sizeLevel) }}#}

            <div class="mt-4 flex gap-5 justify-end">
                {{ form_row(form.submit, {
                    attr: { 'class': 'btn btn-sm text-white bg-[#2E6B28]' },
                }) }}
            </div>
        </div>

        {{ form_end(form) }}
    </div>

</div>
