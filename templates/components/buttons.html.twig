{# Bouton Lien Primaire #}
{% macro primary_link(text, href, size = 'md', icon = null) %}
    <a href="{{ href }}" class="btn btn-primary btn-{{ size }}">
        {% if icon %}
            <span class="btn-icon-wrapper" aria-hidden="true">{{ icon }}</span>
        {% endif %}
        <span class="btn-text">{{ text }}</span>
