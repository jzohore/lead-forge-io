{% extends 'emails/base_email.html.twig' %}

{% block template_email %}
    <!-- Title -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
            <td align="center" style="font-size:22px; font-weight:700; color:#0B261C; letter-spacing:-0.5px;">
                Bienvenue parmi nous,
            </td>
        </tr>
        <tr>
            <td height="8" style="line-height:8px; font-size:0;">&nbsp;</td>
        </tr>
    </table>

    <!-- Subtitle -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
            <td align="center" style="font-size:15px; color:#555; line-height:1.6;">
                Merci de rejoindre le programme d’accès anticipé de <strong>{{ company_name }}</strong>.
                Votre inscription a bien été enregistrée.
            </td>
        </tr>
        <tr>
            <td height="30" style="line-height:30px; font-size:0;">&nbsp;</td>
        </tr>
    </table>

    <!-- Description -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
            <td align="center" style="font-size:16px; color:#515154; line-height:1.6;">
                Notre équipe prépare actuellement votre accès.
                Vous recevrez très bientôt un email pour activer votre compte et découvrir les premières fonctionnalités.
            </td>
        </tr>
        <tr>
            <td height="40" style="line-height:40px; font-size:0;">&nbsp;</td>
        </tr>
    </table>


    <!-- Divider -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:50px;">
        <tr>
            <td style="border-top:1px solid #d2d2d7; height:1px; line-height:1px; font-size:0;">&nbsp;</td>
        </tr>
    </table>

    <!-- Footer Note -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:30px;">
        <tr>
            <td align="center" style="font-size:12px; color:#86868b;">
                <span style="margin-right:6px; color:#34C759;">🔒</span>
                Cet email vous a été envoyé par <strong>{{ company_name }}</strong> de manière sécurisée.<br>
                Merci de votre confiance 💚
            </td>
        </tr>
    </table>

{% endblock %}
