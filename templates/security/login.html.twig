{# templates/security/login.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Connexion - LeadForge{% endblock %}

{% block meta_description %}Connectez-vous à votre compte LeadForge pour accéder à vos leads qualifiés.{% endblock %}

{% block main %}
    <div class="min-h-screen flex items-center justify-center px-4 sm:px-6 lg:px-8 bg-gray-50">
        <div class="max-w-md w-full space-y-8">

            {# Logo/Titre #}
            <div class="">
                <h1 class="text-2xl font-bold text-gray-900">
                    Bon retour parmi nous
                </h1>
                <p class="mt-2 text-sm text-gray-600">
                    Pas encore de compte ?
                    <a href="/inscription" class="font-medium text-[#0B261C] hover:text-emerald-600 transition-colors">
                        Essayez gratuitement →
                    </a>
                </p>
            </div>

            {# Message d'erreur #}
            {% if error %}
                <div class="rounded-md bg-red-50 border border-red-200 p-4" role="alert">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium text-red-800">
                                Email ou mot de passe incorrect
                            </p>
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Formulaire #}
            <form class="mt-8 space-y-6" action="{{ path('app_login') }}" method="post">

                {# Email #}
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
                        Adresse email
                    </label>
                    <input
                        type="email"
                        id="email"
                        name="_username"
                        value="{{ last_username }}"
                        required
                        autocomplete="email"
                        autofocus
                        class="appearance-none relative block w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm transition-colors"
                        placeholder="vous@exemple.com"
                    >
                </div>

                {# Mot de passe #}
                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-1">
                        Mot de passe
                    </label>
                    <input
                        type="password"
                        id="password"
                        name="_password"
                        required
                        autocomplete="current-password"
                        class="appearance-none relative block w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 text-gray-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 sm:text-sm transition-colors"
                        placeholder="••••••••"
                    >
                </div>

                {# Remember me + Mot de passe oublié #}
                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <input
                            type="checkbox"
                            id="remember_me"
                            name="_remember_me"
                            class="h-4 w-4 text-[#0B261C] focus:ring-emerald-500 border-gray-300 rounded cursor-pointer"
                        >
                        <label for="remember_me" class="ml-2 block text-sm text-gray-700 cursor-pointer">
                            Se souvenir de moi
                        </label>
                    </div>

                    <div class="text-sm">
                        <a href="/mot-de-passe-oublie" class="font-medium text-[#0B261C] hover:text-emerald-600 transition-colors">
                            Mot de passe oublié ?
                        </a>
                    </div>
                </div>

                {# CSRF Token #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                {# Bouton Submit #}
                <div>
                    <button
                        type="submit"
                        class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-[#0B261C] hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors duration-200"
                    >
                    <span class="absolute left-0 inset-y-0 flex items-center pl-3">
                        <svg class="h-5 w-5 text-emerald-300 group-hover:text-emerald-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                        </svg>
                    </span>
                        Se connecter
                    </button>
                </div>
            </form>

            {# Note légale #}
            <p class="mt-6 text-center text-xs text-gray-500">
                En vous connectant, vous acceptez nos
                <a href="/mentions-legales" class="underline hover:text-[#0B261C]">Conditions d'utilisation</a>
                et notre
                <a href="/confidentialite" class="underline hover:text-[#0B261C]">Politique de confidentialité</a>.
            </p>
        </div>
    </div>
{% endblock %}
